<?xml version="1.0"?>
<ruleset name="Spectral Dot Reservations">
	<description>WordPress and PHP 7.4 compatibility rules for Spectral Dot Reservations.</description>

	<file>spectral-dot-reservations.php</file>
	<file>includes</file>
	<file>templates</file>
	<file>uninstall.php</file>

	<exclude-pattern>vendor/*</exclude-pattern>
	<arg name="basepath" value="."/>
	<arg name="colors"/>
	<arg value="sp"/>
	<config name="testVersion" value="7.4-"/>

	<rule ref="WordPress-Core"/>
	<rule ref="PHPCompatibility"/>

	<rule ref="WordPress.Files.FileName">
		<exclude-pattern>spectral-dot-reservations.php</exclude-pattern>
	</rule>
</ruleset>
